# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed — these are the app's Firebase and Google Maps/Places keys.

# Firebase console → Project settings → General → "Your apps" → SDK setup and
# configuration → Config.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# console.cloud.google.com → same Firebase project → APIs & Services →
# Credentials. Used for both Google Places API (search/autocomplete/photos)
# and Maps SDK for Android/Static Maps.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# sentry.io → your project → Settings → Client Keys (DSN). Leave blank to
# disable crash/error reporting entirely (Sentry.init() is skipped — see
# src/config/sentry.ts). DSNs are meant to be client-embedded and aren't
# secret, but this stays out of source for consistency with the other keys.
EXPO_PUBLIC_SENTRY_DSN=
# Sentry org/project slugs for the Expo config plugin (only used by native/EAS builds).
SENTRY_ORG=
SENTRY_PROJECT=
