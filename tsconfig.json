{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  // Overrides (not merges with) the base's exclude, so its entries are repeated here. functions/ is
  // its own TypeScript project with its own node_modules (typechecked separately in CI), and
  // .claude/ holds git worktrees of other branches.
  "exclude": ["node_modules", "babel.config.js", "metro.config.js", "jest.config.js", "android", "ios", "functions", ".claude"]
}
